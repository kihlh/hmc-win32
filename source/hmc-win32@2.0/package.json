    "bin/HMC@Beta_x64.node",
    "bin/HMC@Beta_x86.node",
    "index.cjs",
    "hmc-esm.mjs"
  ],
  "homepage": "https://kihlh.gitbook.io/hmc/",
  "scripts": {
    "build": "cd CPP&&node-gyp rebuild",
    "ts": "tsc -d -w",
