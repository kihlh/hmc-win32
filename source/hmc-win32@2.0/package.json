{
  "name": "hmc-win32",
  "version": "2.0.0",
  "description": "Connect to the system api in the easiest way (win-api)",
  "license": "MIT License",
  "main": "./index.cjs",
  "types": "./type/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kihlh/hmc-win32.git"
  },
  "exports": {
    ".": {
      "types": "./type/index.d.ts",
      "import": "./hmc-esm.mjs",
      "require": "./index.cjs"
    },
    "./esm":{
      "types": "./type/index.d.ts",
      "import": "./hmc-esm.mjs",
      "require": "./hmc-esm.mjs"
    }
  },
